# Copie para .env.local (desenvolvimento) e configure o mesmo na Vercel (Settings > Environment Variables).
# NUNCA faça commit de .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública da plataforma (usada em e-mails e redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Perfect Pay (preencher após analisar a documentação/payloads reais) ---
PERFECTPAY_WEBHOOK_TOKEN=

# --- E-mail transacional (primeiro acesso) ---
RESEND_API_KEY=
EMAIL_FROM=
